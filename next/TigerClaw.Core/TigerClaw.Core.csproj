<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <OutputType Condition="'$(Configuration)' == 'Debug'">Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TigerClaw.Core</AssemblyName>
    <RootNamespace>TigerClaw.Core</RootNamespace>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\_run\</BaseOutputPath>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TigerClaw.Pinyin\TigerClaw.Pinyin.csproj" />
    <Compile Include="..\TigerClaw.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\sentence_common_chars_1500.txt" />
    <EmbeddedResource Include="Data\sentence_char_ranks.txt" />
    <EmbeddedResource Include="Data\sentence_lexical.bin" />
  </ItemGroup>
</Project>
