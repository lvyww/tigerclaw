<Window x:Class="TigerClaw.Dialog.AddCiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="虎爪输入法加词"
        Icon="bime.ico"
        Height="160"
        Width="250"
        Background="#505050"
        Foreground="LightGray"
        WindowStyle="ToolWindow"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,10,20,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="50" />
            <ColumnDefinition Width="Auto" MinWidth="50" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Foreground="LightGray"
               Content="词条"
               FontSize="14"
               Margin="5,3,5,3"
               VerticalAlignment="Center" />
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="5,3,5,3">
            <Button x:Name="PrevHistoryButton"
                    Content="&lt;"
                    Width="26"
                    Height="26"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Click="OnPrevHistoryClick" />
            <TextBox x:Name="WordTextBox"
                     MinWidth="120"
                     FontSize="14"
                     Margin="0,3,0,3"
                     Padding="3,3,3,3"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextChanged="OnWordTextChanged" />
            <Button x:Name="NextHistoryButton"
                    Content="&gt;"
                    Width="26"
                    Height="26"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Click="OnNextHistoryClick" />
        </StackPanel>

        <Label x:Name="CodeLabel" Grid.Row="1"
               Grid.Column="0"
               Foreground="LightGray"
               Content="编码"
               FontSize="14"
               Margin="5,3,5,3"
               VerticalAlignment="Center" />
        <TextBox x:Name="CodeTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 MinWidth="140"
                 FontSize="14"
                 Margin="5,3,5,3"
                 Padding="3,3,3,3"
                 InputMethod.IsInputMethodEnabled="False" />

        <Button x:Name="DeletePinyinButton" Grid.Row="4" Grid.ColumnSpan="2" Content="删除此用户词"
                Visibility="Collapsed" Margin="5" Click="OnDeletePinyinClick" />
        <Button x:Name="PinyinManagerButton" Grid.Row="5" Grid.ColumnSpan="2" Content="短语与候选管理…"
                Visibility="Collapsed" Margin="5" Click="OnPinyinManagerClick" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text=" "
                   Foreground="LightGray"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MinWidth="160"
                   MinHeight="20"
                   FontSize="14"
                   Margin="5,1,5,1"
                   Padding="3,3,3,3" />

        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="60" />
                <ColumnDefinition Width="*" MinWidth="80" />
                <ColumnDefinition Width="*" MinWidth="60" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    MinWidth="40"
                    FontSize="14"
                    Content="添加"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnAddAndCloseClick" />
            <Button Grid.Column="1"
                    MinWidth="40"
                    FontSize="14"
                    Content="继续添加"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnAddAndKeepClick" />
            <Button Grid.Column="2"
                    MinWidth="40"
                    FontSize="14"
                    Content="取消"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
