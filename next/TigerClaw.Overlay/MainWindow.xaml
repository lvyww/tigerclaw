<Window x:Class="TigerClaw.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TigerClaw.Overlay"
        Title="TigerClawCandidate"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="360"
        Height="40"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        BorderThickness="1"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        Loaded="Window_Loaded">
    <Border x:Name="BorderCandi"
            BorderBrush="#FF1A7B6B"
            BorderThickness="1"
            CornerRadius="5"
            Background="#FFFFF8F3"
            SnapsToDevicePixels="True"
            MouseUp="Disp_MouseUp"
            MouseWheel="Disp_MouseWheel">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CandidateTransform" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="3"
                              ShadowDepth="1"
                              Direction="270"
                              Opacity="0.18"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <TextBlock x:Name="CandidateText"
                       Text=""
                       TextWrapping="NoWrap"
                       TextAlignment="Left"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       SnapsToDevicePixels="True">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="1.8"
                                      ShadowDepth="0"
                                      Opacity="0.22"
                                      Color="#22000000" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>
    </Border>
</Window>
