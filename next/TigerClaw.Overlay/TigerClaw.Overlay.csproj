<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TigerClawTargetFramework Condition="'$(TigerClawTargetFramework)' == ''">net48</TigerClawTargetFramework>
    <TargetFramework>$(TigerClawTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>TigerClaw.Overlay</AssemblyName>
    <RootNamespace>TigerClaw.Overlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TigerClaw.Shared\TigerClaw.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
